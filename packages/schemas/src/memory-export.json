{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-hub.dev/schemas/memory-export.json",
  "title": "MemoryExport",
  "description": "Schema for AI agent memory exports",
  "type": "object",
  "required": ["agentId", "agentType", "exportedAt", "memories"],
  "properties": {
    "agentId": {
      "type": "string",
      "description": "Unique identifier of the agent"
    },
    "agentType": {
      "type": "string",
      "enum": ["claude", "gpt", "gemini", "ollama", "custom"],
      "description": "Type of AI agent"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of export"
    },
    "memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemoryEntry"
      },
      "description": "List of memory entries"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the export"
    }
  },
  "$defs": {
    "MemoryEntry": {
      "type": "object",
      "required": ["id", "content", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the memory entry"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "The memory content text"
        },
        "context": {
          "type": "string",
          "description": "Surrounding context for the memory"
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Importance score from 0 to 1"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorization"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the memory was created"
        }
      }
    }
  }
}
