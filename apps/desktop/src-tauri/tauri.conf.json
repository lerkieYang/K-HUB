{
  "productName": "K-HUB",
  "version": "2.5.2",
  "identifier": "com.knowledgehub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K-HUB",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "hub-service.exe",
      "resources/tesseract/**/*",
      "resources/poppler/**/*"
    ],
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
